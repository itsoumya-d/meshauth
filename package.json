{
  "name": "meshauth",
  "version": "1.0.0",
  "description": "Passwordless authentication SDK using WebAuthn/Passkeys",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
