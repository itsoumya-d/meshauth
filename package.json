  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itsoumya-d/meshauth"
  },
  "homepage": "https://itsoumya-d.github.io/meshauth/",
  "bugs": {
    "url": "https://github.com/itsoumya-d/meshauth/issues"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "webauthn",
